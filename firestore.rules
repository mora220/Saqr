rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // صفحة الطالب kids/{code}: صاحبها المعلم، وأولياء الأمور المربوطين في parents
    function kidDoc(code) { return get(/databases/$(database)/documents/kids/$(code)); }
    function kidExists(code) { return exists(/databases/$(database)/documents/kids/$(code)); }
    function isKidOwner(code) { return request.auth != null && kidExists(code) && kidDoc(code).data.owner == request.auth.uid; }
    function isKidParent(code) { return request.auth != null && kidExists(code) && request.auth.uid in kidDoc(code).data.get('parents', {}); }
    function isMember(code) { return isKidOwner(code) || isKidParent(code); }

    // الرسائل بين المعلم وأولياء الأمور: محادثة لكل طالب
    match /threads/{code} {
      allow get: if isMember(code);
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if isMember(code) && request.resource.data.owner == kidDoc(code).data.owner;
      allow update: if isMember(code) && request.resource.data.owner == resource.data.owner;
      allow delete: if isKidOwner(code);
      match /msgs/{id} {
        allow read: if isMember(code);
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
          && request.resource.data.at is int
          && ((request.resource.data.by == 't' && isKidOwner(code)) || (request.resource.data.by == 'p' && isKidParent(code)));
        allow delete: if isKidOwner(code);
      }
    }

    // الواجبات: الأسئلة في hw/{id}، والطالب بيقرأها بالـ id من صفحته
    match /hw/{hid} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // حل الطالب: subs/{hw}_{code} — الطالب بيسلّم مرة واحدة من غير حساب، قبل الموعد، والمعلم بيصحح ويدي النقاط
    function hwOf(hid) { return get(/databases/$(database)/documents/hw/$(hid)).data; }
    match /subs/{sid} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if sid == request.resource.data.hw + '_' + request.resource.data.code
        && request.resource.data.keys().hasOnly(['owner', 'hw', 'cid', 'code', 'name', 'ans', 'score', 'total', 'at', 'awarded'])
        && exists(/databases/$(database)/documents/hw/$(request.resource.data.hw))
        && hwOf(request.resource.data.hw).owner == request.resource.data.owner
        && hwOf(request.resource.data.hw).cid == request.resource.data.cid
        && request.time.toMillis() <= hwOf(request.resource.data.hw).due
        && kidExists(request.resource.data.code)
        && kidDoc(request.resource.data.code).data.cid == request.resource.data.cid
        && request.resource.data.awarded == false
        && request.resource.data.ans is list && request.resource.data.ans.size() <= 100
        && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['awarded', 'pts']);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // لوحة صدارة الفصل: الطالب بيقراها برقم الفصل، وفيها الاسم الأول بس
    match /boards/{cid} {
      allow get: if true;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid
        && exists(/databases/$(database)/documents/classes/$(cid))
        && get(/databases/$(database)/documents/classes/$(cid)).data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    // المدرسة: المدير صاحب المستند، والمعلم بينضم بكود المدرسة (رقم المستند)
    function schoolDoc(code) { return get(/databases/$(database)/documents/schools/$(code)).data; }
    match /schools/{code} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && (
        (resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['teachers'])
            && request.resource.data.get('teachers', {}).diff(resource.data.get('teachers', {})).affectedKeys().hasOnly([request.auth.uid])));
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      // ملخص كل معلم (أرقام بس) — المدير بيقراه
      match /stats/{tid} {
        allow read: if request.auth != null && (request.auth.uid == tid || schoolDoc(code).owner == request.auth.uid);
        allow create, update: if request.auth != null && request.auth.uid == tid && request.auth.uid in schoolDoc(code).get('teachers', {});
        allow delete: if request.auth != null && (request.auth.uid == tid || schoolDoc(code).owner == request.auth.uid);
      }
    }

    // فصول المعلم: يشوفها ويعدّلها صاحبها بس
    match /classes/{classId} {
      allow read, delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
    }

    // دور المستخدم (معلم / ولي أمر)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // أبناء ولي الأمر
    match /parents/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // صفحة الطالب: اللي معاه الكود يقدر يقرأها، ومحدش يقدر يعرض القائمة كلها غير المعلم
    match /kids/{code} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      allow update: if
        (request.auth != null && resource.data.owner == request.auth.uid
          && request.resource.data.owner == request.auth.uid)
        ||
        // الطالب يغيّر شكل صقره بس
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['look', 'lookAt'])
          && request.resource.data.look.keys().hasOnly(['body', 'acc'])
          && request.resource.data.look.body is string && request.resource.data.look.body.size() <= 9
          && request.resource.data.look.acc is string && request.resource.data.look.acc.size() <= 12
          && request.resource.data.lookAt is int)
        ||
        // الطالب يطلب مكافأة من المتجر في حدود رصيده، أو يلغي طلبه
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['req'])
          && (!('req' in request.resource.data)
            || (request.resource.data.req.keys().hasOnly(['id', 't', 'e', 'c', 'at'])
              && request.resource.data.req.t is string && request.resource.data.req.t.size() <= 40
              && request.resource.data.req.e is string && request.resource.data.req.e.size() <= 12
              && request.resource.data.req.c is int && request.resource.data.req.c <= resource.data.get('balance', 0))))
        ||
        // ولي الأمر يربط / يفك حسابه بالطالب
        (request.auth != null
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parents'])
          && request.resource.data.get('parents', {}).diff(resource.data.get('parents', {})).affectedKeys().hasOnly([request.auth.uid]));
    }
  }
}
